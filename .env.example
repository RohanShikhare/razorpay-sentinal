# ==============================================================================
# RAZORPAY SENTINEL — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
PORT=8080
SENTINEL_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel
DB_USER=sentinel
DB_PASSWORD=sentinel

# ------------------------------------------------------------------------------
# Module 6: AI Diagnostic Agent Configuration
# ------------------------------------------------------------------------------
# AI_PROVIDER: 'mock' (deterministic, default for local testing) or 'gemini' (live LLM)
AI_PROVIDER=mock

# AI_API_KEY: Required only when AI_PROVIDER is set to 'gemini'
AI_API_KEY=

# AI_MODEL: Target model name (e.g., 'gemini-1.5-flash', 'gemini-1.5-pro')
AI_MODEL=gemini-1.5-flash

# AI_TEMPERATURE: Sampling temperature (0.0 - 1.0, lower is more deterministic)
AI_TEMPERATURE=0.1

# AI_TIMEOUT_MS: HTTP client timeout in milliseconds
AI_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# Frontend Next.js Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
